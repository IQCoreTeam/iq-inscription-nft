{
  "name": "iq-trait-packs-client-local",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run build && node --test test/*.test.mjs",
    "build": "esbuild browser-entry.mjs --bundle --platform=browser --format=esm --outfile=dist/browser.js --alias:@solana/web3.js=./node_modules/@solana/web3.js --alias:buffer=./node_modules/buffer --alias:@noble/hashes=./node_modules/@noble/hashes"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@solana/signers": "2.0.0",
    "@solana/web3.js": "1.99.0",
    "@tensor-foundation/marketplace": "1.0.0",
    "@wallet-standard/app": "1.1.1",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "26.1.0"
  }
}
