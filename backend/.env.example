# iq-inscription-nft backend. Copy to backend/.env and fill in. Never commit .env.
#
# Network-coupled URLs (gateway, tensor, irys, explorer, the RPC default) are NOT
# here anymore: they live in backend/src/networks.ts, keyed by CLUSTER, so a
# devnet deploy can never carry a mainnet gateway. This file only selects the
# cluster and supplies secrets/paths. To retune a network, edit networks.ts.
PORT=8787
# The one switch: "devnet" or "mainnet". Picks the preset in networks.ts.
CLUSTER=devnet
DB_PATH=backend/.data/nft.sqlite
# The registrar hot key. Co-signer only, NEVER the fee payer. File mode 0600.
REGISTRAR_KEYPAIR=backend/.registrar.json
# Optional: override the RPC pool (comma separated, primary first) when you have
# a keyed endpoint (e.g. mainnet Helius). Unset = the cluster's public default.
# RPC_URLS=
SITE_BASE=https://iqlabs.dev
SINGLE_SLUG=iq6900-inscriptions
# The launchpad is served under iqlabs.dev, so the browser Origin must be allowed.
CORS_ORIGIN=https://iqlabs.dev,https://iq6900.com
RESERVATION_TTL_SECONDS=600
REAPER_SLACK_SECONDS=60
MAX_OPEN_RESERVATIONS_PER_WALLET=3
RESERVE_PER_IP_PER_MINUTE=10
# Arweave via Irys (deploy-collection and the single-registry init need it). The
# bundler mode + gateway are cluster-derived in networks.ts; only the key is here.
ARWEAVE_KEYPAIR=
# Tensor secondary-market sales (mainnet only; devnet host rejects the key).
TENSOR_API_KEY=
